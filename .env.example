# Copy this file to .env.local and fill in the values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# A long random secret for signing JWT tokens (e.g. run: openssl rand -base64 64)
JWT_SECRET=

# Public base URL — update to your Vercel deployment URL or custom domain after first deploy
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Used only by the seed script (npm run seed:admin) ---
# These are never stored in the database or in any API response
ADMIN_EMAIL=
ADMIN_PASSWORD=
